  "info": {
    "contact": {
      "name": "C\u00e9line Dion fan page",
      "url": "https://celine-dion.it-sefako.com/"
    },
    "description": "Backend for the C\u00e9line Dion fan page. Serves the song catalog with YouTube video IDs so the frontend can play the videos in a player.",
    "license": {
      "name": "Proprietary"
    },
    "title": "C\u00e9line Dion API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "Returns the service status. Used by reverse proxies and orchestrators to verify the backend is reachable.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health check",
        "tags": [
          "health"
        ]
      }
    },
    "/api/songs": {
      "get": {
        "description": "Returns the catalog of songs with their YouTube video IDs so the frontend player can embed and play them.",
        "operationId": "get_songs_api_songs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Song"
                  },
                  "title": "Response Get Songs Api Songs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List available C\u00e9line Dion songs",
        "tags": [
          "songs"
        ]
      }
    },
    "/api/songs/{song_id}": {
      "get": {
        "description": "Returns the details of one song, including its YouTube video ID for embedding in the player.",
        "operationId": "get_song_api_songs__song_id__get",
        "parameters": [
          {
            "description": "Unique song identifier",
            "in": "path",
            "name": "song_id",
            "required": true,
            "schema": {
              "description": "Unique song identifier",
              "title": "Song Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Song"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get a single song by ID",
        "tags": [
          "songs"
        ]
      }
    }
  }
